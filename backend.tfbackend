# Backend configuration for the sandbox environment.
# Fill in the real values before running `terraform init -backend-config=backend.tfbackend`.
# The S3 bucket must have AES256 server-side encryption enabled (encrypt = true).
bucket       = "REPLACE_WITH_TFSTATE_BUCKET"
key          = "path/to/terraform.tfstate"
region       = "REPLACE_WITH_STATE_BUCKET_REGION"
profile      = "REPLACE_WITH_AWS_PROFILE"
encrypt      = true
use_lockfile = true
